{
  "manifest_version": 3,
  "name": "Conferência DOPM",
  "version": "3.0",
  "description": "Executa 6 módulos de conferência do DOPM: Afastamentos, Transferências, Aquisitivo, Suspensões, Exercício e CID-10. Gera relatório unificado.",
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://sei.go.gov.br/*",
    "https://sisp.ssp.go.gov.br/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "images/icon.png",
      "48":  "images/icon.png",
      "128": "images/icon.png"
    },
    "default_title": "Conferência DOPM"
  },
  "icons": {
    "16":  "images/icon.png",
    "48":  "images/icon.png",
    "128": "images/icon.png"
  }
}
